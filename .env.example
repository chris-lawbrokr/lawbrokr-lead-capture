# HubSpot account ID — Settings > Account Setup > Account Defaults
VITE_HUBSPOT_PORTAL_ID=

# GUID of the HubSpot form that receives this widget's fields.
# Custom properties required: firm_website, firm_size,
# practice_area, primary_pain_point, lead_heat
VITE_HUBSPOT_FORM_GUID=

# Discovery-call scheduler embedded at the end of the flow
VITE_HUBSPOT_MEETING_LINK=

# Internal name of the custom behavioural event, e.g. pe1234567_demo_widget_engaged
VITE_HUBSPOT_ENGAGEMENT_EVENT=

# Serverless relay that posts the "someone just started" Slack alert
VITE_LEAD_STARTED_ENDPOINT=/api/lead-started

# Zapier "Catch Hook" URL. When set, submissions go here instead of the Forms API
# and the Zap's HubSpot "Create or Update Contact" step writes them.
VITE_ZAPIER_WEBHOOK_URL=

# ---- Web audit (/audit/) ----
# Shares the portal ID and meeting link above. Its form and Zap are its own.

# GUID of the HubSpot form that receives audit leads.
# Custom properties required: firm_website, firm_domain, practice_area, lead_heat,
# audit_score, audit_wants_call, audit_goal, audit_reply_speed, audit_client_source
VITE_AUDIT_HUBSPOT_FORM_GUID=

# Zapier "Catch Hook" URL for audit leads. When set, replaces the Forms API for the audit.
VITE_AUDIT_ZAPIER_WEBHOOK_URL=
