# HubSpot account ID — Settings > Account Setup > Account Defaults
VITE_HUBSPOT_PORTAL_ID=

# GUID of the HubSpot form that receives this widget's fields.
# Custom properties required: firm_website, firm_size, role,
# practice_area, primary_pain_point, lead_heat
VITE_HUBSPOT_FORM_GUID=

# Discovery-call scheduler embedded at the end of the flow
VITE_HUBSPOT_MEETING_LINK=

# Internal name of the custom behavioural event, e.g. pe1234567_demo_widget_engaged
VITE_HUBSPOT_ENGAGEMENT_EVENT=

# Serverless relay that posts the "someone just started" Slack alert
VITE_LEAD_STARTED_ENDPOINT=/api/lead-started
